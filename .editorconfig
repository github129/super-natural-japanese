# EditorConfig: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Markdown では行末の 2 スペースが改行の意味を持つため保持する
trim_trailing_whitespace = false

[*.py]
indent_size = 4

[Makefile]
indent_style = tab
